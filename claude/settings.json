{
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoDreamEnabled": true,
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true
  },
  "model": "opus[1m]",
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(rg *)",
      "Bash(command -v *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(jq *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(realpath *)",
      "Bash(file *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/id_rsa*)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(~/.ssh/**)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf --no-preserve-root /)",
      "Bash(rm -rf --no-preserve-root / *)",
      "Bash(mkfs.*)",
      "Bash(dd if=*)"
    ]
  },
  "statusLine": {
    "command": "sh ~/.claude/statusline-command.sh",
    "refreshInterval": 10000,
    "type": "command"
  },
  "tui": "fullscreen"
}
