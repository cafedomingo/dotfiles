{
  "permissions": {
    "allow": [
      "Bash(basename *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(command -v *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(dirname *)",
      "Bash(file *)",
      "Bash(find . *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(realpath *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(tr *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "WebFetch(domain:*.github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:github.com)",
      "WebSearch"
    ],
    "ask": [
      "Bash(apt install *)",
      "Bash(apt-get install *)",
      "Bash(brew install *)",
      "Bash(curl *)",
      "Bash(dnf install *)",
      "Bash(docker build *)",
      "Bash(docker compose *)",
      "Bash(docker pull *)",
      "Bash(docker run *)",
      "Bash(git cherry-pick *)",
      "Bash(git clean *)",
      "Bash(git clone *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(kubectl apply *)",
      "Bash(nc *)",
      "Bash(netcat *)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(pipx install *)",
      "Bash(pnpm install *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rsync *)",
      "Bash(scp *)",
      "Bash(socat *)",
      "Bash(ssh *)",
      "Bash(wget *)",
      "Bash(yarn add *)",
      "Bash(yum install *)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(dd if=*)",
      "Bash(mkfs.*)",
      "Bash(rm -rf --no-preserve-root /)",
      "Bash(rm -rf --no-preserve-root / *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Read(**/*.jks)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/id_rsa*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "sandbox": {
    "credentials": {
      "files": [
        { "mode": "deny", "path": "~/.aws/credentials" }
      ]
    },
    "enabled": true,
    "excludedCommands": ["git commit *", "git push *", "git pull *", "git clone *", "git fetch *", "gh *", "ssh *", "scp *", "rsync *", "make *"],
    "filesystem": {
      "allowRead": ["~/.ssh/*.pub", "~/.ssh/config", "~/.ssh/known_hosts"],
      "denyRead": ["~/.ssh"]
    }
  },

  "enabledPlugins": {
    "caveman@caveman": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    }
  },

  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoDreamEnabled": true,
  "skipAutoPermissionPrompt": true,

  "statusLine": {
    "command": "sh ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "tui": "fullscreen"
}
